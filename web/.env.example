# Admin site password (required — no fallback in production)
SITE_PASSWORD=choose-a-strong-password

# Security staff password (required — no fallback in production)
SECURITY_PASSWORD=choose-a-strong-password

# Backend URL used by Vercel rewrites and server-side fetches (no trailing slash)
BACKEND_URL=https://backend.v0.youare-invited.com

# Optional public browser API override.
# On https://www.youare-invited.com the app already calls the backend domain
# directly by default to avoid Vercel rewrite redirect loops.
# Optional local/debug override:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Optional organizer support contact details for the in-app support center
NEXT_PUBLIC_SUPPORT_EMAIL=support@youare-invited.com
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/15551234567
 NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com