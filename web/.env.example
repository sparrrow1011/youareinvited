# Admin site password (required — no fallback in production)
SITE_PASSWORD=choose-a-strong-password

# Security staff password (required — no fallback in production)
SECURITY_PASSWORD=choose-a-strong-password

# Backend URL used by Vercel rewrites and server-side fetches (no trailing slash)
BACKEND_URL=https://backend.v0.youare-invited.com

# Leave NEXT_PUBLIC_API_URL unset in production so the browser stays on
# https://www.youare-invited.com/api/... and Vercel proxies requests to BACKEND_URL.
# Optional browser override for local debugging only:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
