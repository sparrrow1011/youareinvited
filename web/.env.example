# Admin site password (required — no fallback in production)
SITE_PASSWORD=choose-a-strong-password

# Security staff password (required — no fallback in production)
SECURITY_PASSWORD=choose-a-strong-password

# Backend API base URL (used by api.ts; falls back to deployed Vercel URL if unset)
NEXT_PUBLIC_API_URL=https://event-invitation-backend.vercel.app/api

# Backend URL for Next.js rewrites in next.config.js (dev only)
BACKEND_URL=http://localhost:8000
