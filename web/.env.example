# Admin site password (required — no fallback in production)
SITE_PASSWORD=choose-a-strong-password

# Security staff password (required — no fallback in production)
SECURITY_PASSWORD=choose-a-strong-password

# Backend URL used by rewrites and server-side fetches (no trailing slash)
BACKEND_URL=https://your-backend-project.vercel.app

# Optional browser override. Leave unset to use same-origin /api rewrites.
# NEXT_PUBLIC_API_URL=https://your-backend-project.vercel.app/api
