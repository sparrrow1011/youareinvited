# Django
SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Database (leave blank to use SQLite in development)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS & CSRF — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://invitation-system-psi.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://invitation-system-psi.vercel.app

# Cloudinary — rotate these if they were ever committed to version control
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Super-admin
SUPER_ADMIN_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_ORIGIN=https://your-admin-project.vercel.app
