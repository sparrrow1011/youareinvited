# Django
SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DEBUG=False
# Public backend URL used to auto-allow your custom backend host (no trailing slash)
BACKEND_URL=https://backend.v0.youare-invited.com
# Public web app URL used for guest invite links, QR codes, and WhatsApp shares
FRONTEND_URL=https://www.youare-invited.com
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,backend.v0.youare-invited.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Database (leave blank to use SQLite in development)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# CORS & CSRF — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.youare-invited.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://www.youare-invited.com

# AWS S3 media storage
# Required in production for template uploads and generated QR/e-invite images.
# Leave all AWS values blank in local dev to keep using backend/media/.
# The bucket must allow public GetObject (via bucket policy or public-read ACL).
# Files are organised as: {username}/{event-slug}/template|qr|invites/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=youareinvited-media
AWS_S3_REGION_NAME=eu-west-2
# Optional: CloudFront or custom domain (no https://, no trailing slash)
AWS_S3_CUSTOM_DOMAIN=

# Super-admin
SUPER_ADMIN_SECRET=replace-with-a-long-random-secret
SUPER_ADMIN_ORIGIN=https://your-admin-project.vercel.app

GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com