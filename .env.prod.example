# ============================================================
# Production Environment — copy to .env.prod and fill values
# ============================================================

# Database (use a strong random password)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Django Backend
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET_KEY
ALLOWED_HOSTS=backend.v0.youare-invited.com,178.128.164.135
BACKEND_URL=https://backend.v0.youare-invited.com
FRONTEND_URL=https://youare-invited.com

# Frontend (public — baked into client bundle at build time)
NEXT_PUBLIC_API_URL=https://backend.v0.youare-invited.com/api
NEXT_PUBLIC_FRONTEND_URL=https://youare-invited.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@youare-invited.com
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=https://wa.me/15551234567

# Frontend server-side secrets (NOT public — runtime only)
SITE_PASSWORD=CHANGE_ME_SITE_PASSWORD
SECURITY_PASSWORD=CHANGE_ME_SECURITY_PASSWORD

# Email (Resend recommended — https://resend.com, 3k emails/month free)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_YOUR_RESEND_API_KEY
DEFAULT_FROM_EMAIL=noreply@youare-invited.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Twilio (WhatsApp/SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+15559209134

# AWS S3 — optional, for media file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
USE_S3_STORAGE=False
